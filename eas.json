{
  "cli": {
    "version": ">= 22.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "ADMOB_REQUIRE_PRODUCTION": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
